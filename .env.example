# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables (Production AND Preview).
# Use The Vial Vault's OWN Supabase project — never TruPep's.
VITE_SUPABASE_URL=https://YOUR-VIAL-VAULT-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-vial-vault-anon-public-key
# Server-side only (used by /api/chat for the chat assistant)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
